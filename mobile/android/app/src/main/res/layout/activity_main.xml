<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- LAYER 1: MAIN APPLICATION VIEW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <LinearLayout
            android:id="@+id/top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="42dp"
            android:paddingBottom="12dp"
            android:background="@color/surface">

            <ImageButton
                android:id="@+id/btn_open_drawer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_hamburger"
                android:tint="@color/text_primary"
                android:contentDescription="Open navigation drawer" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/app_logo"
                android:contentDescription="Lecture Whisper Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lecture Whisper"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pixel 8a • Local Academic Intelligence"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Live Connection Status Chip -->
            <LinearLayout
                android:id="@+id/chip_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_connected"
                android:paddingHorizontal="10dp">

                <View
                    android:id="@+id/view_connection_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_hero_record_idle"
                    android:backgroundTint="@color/status_connected_text" />

                <TextView
                    android:id="@+id/text_connection_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connected"
                    android:textColor="@color/status_connected_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Content Area: Tab Views -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- TAB 1: LIVE RECORDER -->
            <ScrollView
                android:id="@+id/view_tab_recorder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Dynamic Timetable Slot Banner -->
                    <LinearLayout
                        android:id="@+id/banner_timetable_slot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_banner_active_class"
                        android:padding="14dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/text_banner_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURRENT CLASS IN PROGRESS"
                            android:textColor="#34D399"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_banner_subject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CS 101: Data Structures"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/text_banner_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09:00 – 10:30 • Hall B • Prof. Turing"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Hero Recording Panel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/text_recording_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_ready"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/text_recording_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00:00"
                            android:textColor="@color/text_primary"
                            android:textSize="44sp"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp" />

                        <!-- Circular Record Button -->
                        <Button
                            android:id="@+id/btn_hero_record"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:background="@drawable/bg_hero_record_idle"
                            android:text="REC"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="20dp" />

                        <TextView
                            android:id="@+id/text_chunk_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10-Minute Rotating Chunks • 16 kHz Mono AAC"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="18dp" />

                        <!-- Subject override input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Lecture Subject:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/edit_recording_subject"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_field"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:paddingHorizontal="12dp"
                                android:text="CS 101: Data Structures"
                                android:singleLine="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quick Sync Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="16dp"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Local Wi-Fi Auto-Sync"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_sync_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Syncs audio chunks and timetable updates automatically when connected to MacBook Pro."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                        <Button
                            android:id="@+id/btn_sync_now"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_btn_primary"
                            android:text="Sync Unsynced Audio to Laptop"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- TAB 2: TIMETABLE & OCR -->
            <ScrollView
                android:id="@+id/view_tab_timetable"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly Academic Schedule"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload a timetable photo for OCR parsing or add classes manually."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <!-- Top Timetable Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <Button
                            android:id="@+id/btn_upload_timetable_ocr"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_primary"
                            android:text="📷 Scan Timetable Photo"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btn_add_slot"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:text="+ Add Class"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <!-- OCR Progress Indicator Card -->
                    <LinearLayout
                        android:id="@+id/layout_ocr_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card"
                        android:padding="14dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="24dp"
                            android:layout_height="24dp" />

                        <TextView
                            android:id="@+id/text_ocr_progress_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Uploading photo to MacBook for ML OCR grid parsing..."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <!-- Weekday Selector -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:id="@+id/layout_weekday_selector"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_day_mon"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_btn_primary"
                                android:text="Mon"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_day_tue"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_input_field"
                                android:text="Tue"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_day_wed"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_input_field"
                                android:text="Wed"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_day_thu"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_input_field"
                                android:text="Thu"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_day_fri"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_input_field"
                                android:text="Fri"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_day_sat"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_input_field"
                                android:text="Sat"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_day_sun"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_input_field"
                                android:text="Sun"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Dynamic List of Slots for Selected Day -->
                    <LinearLayout
                        android:id="@+id/container_timetable_slots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp" />
                </LinearLayout>
            </ScrollView>

            <!-- TAB 3: RECORDINGS & CHUNKS -->
            <ScrollView
                android:id="@+id/view_tab_recordings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device Audio Library"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_recordings_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 sessions stored • 0 MB cached"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <Button
                        android:id="@+id/btn_sync_all_recordings"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_primary"
                        android:text="Sync All Sessions to MacBook"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp" />

                    <!-- List of Recording Sessions -->
                    <LinearLayout
                        android:id="@+id/container_recordings_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp" />
                </LinearLayout>
            </ScrollView>

            <!-- TAB 4: CONNECTION & DIAGNOSTICS -->
            <ScrollView
                android:id="@+id/view_tab_connection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MacBook Pro Connection"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configure server endpoint and review connection instructions."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <!-- Host Configuration Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="16dp"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MacBook Server Host / IP:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/edit_server_host"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_field"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:paddingHorizontal="12dp"
                            android:text="127.0.0.1"
                            android:singleLine="true" />

                        <!-- Quick Host Presets -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <Button
                                android:id="@+id/btn_preset_usb"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_field"
                                android:text="⚡ USB: 127.0.0.1"
                                android:textColor="@color/accent"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:layout_marginEnd="4dp" />

                            <Button
                                android:id="@+id/btn_preset_wifi"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_field"
                                android:text="🌐 Wi-Fi: 172.17.180.61"
                                android:textColor="@color/primary_light"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Port (default: 8000):"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/edit_server_port"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input_field"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:paddingHorizontal="12dp"
                            android:text="8000"
                            android:inputType="number"
                            android:singleLine="true" />

                        <Button
                            android:id="@+id/btn_test_connection"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_btn_primary"
                            android:text="Test Connection"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:id="@+id/text_connection_diagnostic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: Ready to test connection"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>

                    <!-- Interactive Connection Guide Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card"
                        android:padding="16dp"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📖 How to Connect (3 Simple Options)"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Option 1 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Wi-Fi Local Area Network (LAN)"
                            android:textColor="@color/primary_light"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Ensure MacBook and Pixel 8a are on the same Wi-Fi.\n• Run 'lecturewhisper serve' in terminal on your Mac.\n• Enter your Mac's LAN IP (e.g. 192.168.1.x) above and tap Test Connection."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                        <!-- Option 2 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Personal Hotspot (Campus / Dorm)"
                            android:textColor="@color/primary_light"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Turn on Personal Hotspot on Pixel 8a or Mac.\n• Connect the other device to the hotspot.\n• This bypasses campus Wi-Fi device isolation."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                        <!-- Option 3 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Zero-Latency USB Cable (Fastest)"
                            android:textColor="@color/primary_light"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Connect Pixel 8a to MacBook with USB-C cable.\n• In MacBook terminal run:\n  adb reverse tcp:8000 tcp:8000\n• In app set Host to '127.0.0.1' or 'localhost'.\n• Works instantly without any network setup!"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Bottom Navigation Bar Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_border" />

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:id="@+id/bottom_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            android:background="@color/tab_bar_bg">

            <Button
                android:id="@+id/nav_btn_recorder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:drawableTop="@drawable/ic_mic"
                android:drawablePadding="3dp"
                android:drawableTint="@color/primary_light"
                android:text="Record"
                android:textColor="@color/primary_light"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/nav_btn_timetable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:drawableTop="@drawable/ic_calendar"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_muted"
                android:text="Schedule"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/nav_btn_recordings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:drawableTop="@drawable/ic_folder"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_muted"
                android:text="Audio"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/nav_btn_connection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:drawableTop="@drawable/ic_wifi"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_muted"
                android:text="MacBook"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- LAYER 2: DRAWER SCRIM (DIMMER OVERLAY) -->
    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/drawer_scrim"
        android:visibility="gone" />

    <!-- LAYER 3: SLIDING SIDEBAR / NAVIGATION DRAWER -->
    <LinearLayout
        android:id="@+id/sidebar_drawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/drawer_bg"
        android:paddingHorizontal="20dp"
        android:paddingTop="50dp"
        android:paddingBottom="20dp"
        android:translationX="-320dp">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/app_logo"
                android:layout_marginEnd="12dp"
                android:contentDescription="Lecture Whisper Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lecture Whisper"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0.0 Production • Android 17"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_close_drawer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_border"
            android:layout_marginVertical="16dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Storage Information Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STORAGE INFORMATION"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/text_storage_available"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available: 64.20 GB / 128.00 GB"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_storage_app_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lecture Whisper Cache: 0 MB"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/text_storage_synced_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Synced: 0 • Pending: 0"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <Button
                        android:id="@+id/btn_drawer_prune_cache"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:text="🧹 Clean Synced Chunks"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <!-- System & Hardware Specs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE &amp; ENGINE SPECS"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Target: Google Pixel 8a"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OS: Android 17 (API 35+)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio: 16 kHz Mono AAC @ 64 kbps"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mic Source: VOICE_RECOGNITION"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WakeLock: PARTIAL_WAKE_LOCK"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Battery Optimization Check -->
                <Button
                    android:id="@+id/btn_drawer_battery_opt"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input_field"
                    android:text="Check Battery Optimization"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
